{
  "name": "famille-naxa",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/design-system",
    "packages/assistant",
    "packages/offline-web",
    "packages/core-web",
    "apps/web/*"
  ],
  "scripts": {
    "build:web": "npm run build --workspaces --if-present",
    "test:contracts": "npm test --workspace @famille/contracts",
    "test:assistant": "npm test --workspace @famille/assistant-rules",
    "test:core-web": "npm test --workspace @naxa/core-web"
  }
}